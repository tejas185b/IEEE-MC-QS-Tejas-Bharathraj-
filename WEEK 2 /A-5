class Solution {
    public int findRadius(int[] houses, int[] heaters) {
        Arrays.sort(houses);
        Arrays.sort(heaters);
        int max=0;
        int j=0;
        for(int i=0;i<houses.length;i++)
        {
           while(j<heaters.length-1 && Math.abs(houses[i]-heaters[j+1])<=Math.abs(houses[i]-heaters[j]))
                j++;
            int d=Math.abs(heaters[j]-houses[i]);
            max=Math.max(max,d);
        }
        return max;
    }
}
